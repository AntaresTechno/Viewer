b_type=8&cell_id=6952850996422770718&version_tag=video_feed_refactor&device_id=1423244030195267&aid=1967&app_name=novelapp&ssmix=a&session_id={{java.timeFormatUTC(Date.now(), \"yyyyMMddHHmm\", 8)}}\n豪门::https://reading.snssdk.com/reading/bookapi/bookmall/cell/change/v?change_type=0&selected_items=cate_1053&tab_type=8&cell_id=6952850996422770718&version_tag=video_feed_refactor&device_id=1423244030195267&aid=1967&app_name=novelapp&ssmix=a&session_id={{java.timeFormatUTC(Date.now(), \"yyyyMMddHHmm\", 8)}}\n都市::https://reading.snssdk.com/reading/bookapi/bookmall/cell/change/v?change_type=0&selected_items=cate_261&tab_type=8&cell_id=6952850996422770718&version_tag=video_feed_refactor&device_id=1423244030195267&aid=1967&app_name=novelapp&ssmix=a&session_id={{java.timeFormatUTC(Date.now(), \"yyyyMMddHHmm\", 8)}}\n神豪::https://reading.snssdk.com/reading/bookapi/bookmall/cell/change/v?change_type=0&selected_items=cate_20&tab_type=8&cell_id=6952850996422770718&version_tag=video_feed_refactor&device_id=1423244030195267&aid=1967&app_name=novelapp&ssmix=a&session_id={{java.timeFormatUTC(Date.now(), \"yyyyMMddHHmm\", 8)}}\n搜索::{{host}}/search?query={{java.getVerificationCode(source.sourceIcon)}}&tab_type=11",
